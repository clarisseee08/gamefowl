APP_NAME="Digital Broodcock Farm Record Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This project runs on PostgreSQL, not SQLite or MySQL. Laravel's stock example
# file ships DB_CONNECTION=sqlite, which would start the app against an empty
# SQLite file with no error at all - so these are spelled out deliberately.
#
# Development runs against PostgreSQL 17 on your own machine (since 5 November
# 2026), set up as in docs/handover/setup.md sections 1f and 5. You choose
# DB_PASSWORD yourself and give the gfms role the same one. Never commit it.
#
# Production does NOT read this file. Render's database settings (Supabase,
# through the session pooler) are entered in its dashboard; see render.yaml.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gfms
DB_USERNAME=gfms
DB_PASSWORD=<your-local-gfms-password>

# Unblocks migrate:fresh, migrate:refresh, migrate:reset, migrate:rollback and
# db:wipe, which are refused by default on EVERY machine.
#
# Read the DB_HOST above before you set this. Against 127.0.0.1 the worst case
# is losing your test data (restore the dump again). If DB_HOST is ever a
# pooler.supabase.com address, these commands destroy the farm's real records.
# Set this to true only when you are certain the database you are pointed at is
# disposable, and set it straight back to false.
GFMS_ALLOW_DESTRUCTIVE_DB=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Where bird and profile photos are stored. NOTE: this, not FILESYSTEM_DISK,
# is what governs photo uploads.
#
#   public    - storage/app/public on THIS machine. Use this for development.
#   supabase  - Supabase Storage over its S3-compatible gateway: the LIVE
#               bucket the deployed site uses. Production sets this in
#               render.yaml.
#
# Why `public` locally: the database is local now, but the bucket is not. With
# `supabase`, a test upload writes a real file into the live bucket, in the
# folder of whichever REAL bird has the same id (broodcocks/<id>/<uuid>.jpg).
# It can't overwrite a farm photo (the uuid), but nothing will ever reference
# it, and nobody can tell it apart from the farm's own files. The same goes
# for photos:backfill-thumbnails.
#
# History: until 5 November 2026 every environment shared ONE database, and
# then the rule was the reverse - `supabase` everywhere. A photo row records its
# disk (broodcock_photos.disk), so a machine on `public` told the live site,
# through the shared database, that a photo lived on a disk the server didn't
# have. That is how the farm's first two photographs became invisible
# (`php artisan photos:migrate-disk --to=supabase` was the repair). If you
# ever point DB_HOST back at Supabase, switch this to `supabase` with it.
#
# The bucket is private; photos are served through an authorized controller
# and signed temporary URLs, so no public bucket access is needed.
GFMS_PHOTO_DISK=public

# Only needed when GFMS_PHOTO_DISK is supabase. They reach the LIVE bucket.
# From Supabase > Project Settings > Storage > S3 connection.
# SUPABASE_S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# SUPABASE_S3_REGION defaults to ap-northeast-1, SUPABASE_S3_BUCKET to gfms-laravel.

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail.
#
# `log` LOCALLY IS CORRECT - a reset link written to storage/logs/laravel.log is
# exactly what you want while developing, and it cannot mail a real person by
# accident. Read the link out of the log with: php artisan pail
#
# IN PRODUCTION IT IS NOT. Laravel's own default for MAIL_MAILER is also `log`,
# so leaving these unset on Render does not disable password reset - it leaves
# the screen working, the success message showing, and the link going to the
# container's stderr where nobody will ever read it. Fortify's
# Features::resetPasswords() is enabled, so that flow is offered to every user.
# See render.yaml for the production values.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Must be an address at a domain the provider has verified, or the message is
# accepted and then silently dropped.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
DEBUGBAR_ENABLED=false

# ---- What the farm tells the public ----
#
# These feed the footer and the "Visit us" section. Every one is optional, and
# a value left blank renders NOTHING rather than an empty row - so an
# unconfigured install shows a footer with no contact block at all, which is
# correct, rather than "Phone" followed by a gap.
#
# They are not committed as defaults because they are a real person's contact
# details. Set them here locally and in Render's environment for production.
GFMS_FARM_NAME="SSGuad Game Farm"
GFMS_FARM_ADDRESS=
GFMS_FARM_PHONE=
GFMS_FARM_EMAIL=
GFMS_FARM_HOURS=
