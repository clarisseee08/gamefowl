APP_NAME="Digital Broodcock Farm Record Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This project runs on PostgreSQL, not SQLite or MySQL. Laravel's stock example
# file ships DB_CONNECTION=sqlite, which would start the app against an empty
# SQLite file with no error at all - so these are spelled out deliberately.
#
# Values below are PLACEHOLDERS. Real credentials are never committed; see
# docs/handover-setup.md for how they are handed over.
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<your-database-password>

# Supabase's SESSION POOLER, not the direct connection. The direct host is
# IPv6-only and most Philippine home and office connections are IPv4, where it
# fails with a connection timeout that looks like the database being down.

# Unblocks migrate:fresh, migrate:refresh, migrate:reset, migrate:rollback and
# db:wipe, which are refused by default on EVERY machine.
#
# Read the DB_HOST above before you set this. There is no separate development
# database - that host is the same Supabase project the deployed site uses, so
# `migrate:fresh` against it destroys the farm's real records for everyone, not
# a local copy. Set this to true only when you are certain the database you are
# pointed at is disposable, and set it straight back to false.
GFMS_ALLOW_DESTRUCTIVE_DB=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Where bird and profile photos are stored. NOTE: this, not FILESYSTEM_DISK,
# is what governs photo uploads.
#
#   supabase  - Supabase Storage over its S3-compatible gateway.
#   public    - storage/app/public on THIS machine.
#
# USE `supabase` EVERYWHERE, INCLUDING LOCALLY. `public` is not a gentler
# local default; against this project's setup it is a trap.
#
# There is ONE database, shared by every environment - see DB_HOST above. The
# disk a photo was written to is recorded per row, in broodcock_photos.disk,
# which is what lets an old photo still resolve after the default changes. Put
# those two facts together and a machine set to `public` writes the file to its
# own hard drive and then tells every other environment, through the shared
# database, that the photo lives on "public". The deployed site reads that row,
# looks in its own empty storage/app/public, and serves a 404. Nothing errors.
# The row is valid, the file exists, and the page shows a broken image.
#
# That is not hypothetical: it is how the farm's first two photographs became
# invisible on the live site. `php artisan photos:migrate-disk --to=supabase`
# is the repair; pointing every environment at the same bucket is the fix.
#
# The bucket is private; photos are served through an authorized controller
# and signed temporary URLs, so no public bucket access is needed.
GFMS_PHOTO_DISK=supabase

# REQUIRED, because GFMS_PHOTO_DISK is supabase - including for local work.
# From Supabase > Project Settings > Storage > S3 connection.
# SUPABASE_S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# SUPABASE_S3_REGION defaults to ap-northeast-1, SUPABASE_S3_BUCKET to gfms-laravel.

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail.
#
# `log` LOCALLY IS CORRECT - a reset link written to storage/logs/laravel.log is
# exactly what you want while developing, and it cannot mail a real person by
# accident. Read the link out of the log with: php artisan pail
#
# IN PRODUCTION IT IS NOT. Laravel's own default for MAIL_MAILER is also `log`,
# so leaving these unset on Render does not disable password reset - it leaves
# the screen working, the success message showing, and the link going to the
# container's stderr where nobody will ever read it. Fortify's
# Features::resetPasswords() is enabled, so that flow is offered to every user.
# See render.yaml for the production values.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Must be an address at a domain the provider has verified, or the message is
# accepted and then silently dropped.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
DEBUGBAR_ENABLED=false

# ---- What the farm tells the public ----
#
# These feed the footer and the "Visit us" section. Every one is optional, and
# a value left blank renders NOTHING rather than an empty row - so an
# unconfigured install shows a footer with no contact block at all, which is
# correct, rather than "Phone" followed by a gap.
#
# They are not committed as defaults because they are a real person's contact
# details. Set them here locally and in Render's environment for production.
GFMS_FARM_NAME="SSGuad Game Farm"
GFMS_FARM_ADDRESS=
GFMS_FARM_PHONE=
GFMS_FARM_EMAIL=
GFMS_FARM_HOURS=
